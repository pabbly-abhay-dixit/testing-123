# Backend base URL.
# Leave EMPTY when accessing the app via ngrok or behind a reverse proxy so
# axios uses same-origin requests; the Vite dev-server proxy (or nginx in
# prod) forwards /api/* to the backend. Cookies (HttpOnly pabbly_token)
# round-trip cleanly only on a single origin.
VITE_API_URL=

# Pabbly Accounts SSO entry — REQUIRED. The only auth gate.
# Replace `paa` with whatever project name the accounts team registered.
VITE_SSO_REDIRECT_URL=https://accounts.pabbly.com/backend/access?project=paa

# Forward-channel single sign-out URL — REQUIRED. The logout button hits this
# so the accounts.pabbly.com session is destroyed at the same time. Without
# it, the next refresh would silently re-authenticate from accounts.
VITE_SSO_LOGOUT_URL=https://accounts.pabbly.com/logout/

# reCAPTCHA v2 — site key paired with the backend's `RECAPTCHA_SECRET_KEY`.
# Used by the in-app subscription checkout popup to render the "I'm not a
# robot" widget. If unset, the popup falls back to the Pabbly-owned site
# key shared with buy.pabbly.com — paired with the matching secret on
# the backend, the captcha works out of the box. Override this only if
# a separate keypair is ever provisioned for agenticai.pabbly.com.
# Site + secret must rotate together (registered pair on Google's
# reCAPTCHA admin console).
# VITE_RECAPTCHA_SITE_KEY=
